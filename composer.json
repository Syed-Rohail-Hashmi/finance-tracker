{
    "name": "app/finance-tracker",
    "description": "Personal Finance Tracker with Charts - PHP & MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
